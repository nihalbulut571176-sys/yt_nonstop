{
  "profile_id": "fastgen_unstop",
  "schema_version": "draft-1",
  "description": "Still-image workflow with FastGen first, then Veo Nonstop image-to-video for every normalized frame.",
  "pipeline_mode": "images_then_videos",
  "image_generation": {
    "enabled": true,
    "provider": "fastgen",
    "route": "v4-openai-image",
    "normalize_before_render": true
  },
  "animation": {
    "enabled": true,
    "provider": "veononstop",
    "policy": "all_scenes_image_to_video",
    "backoff_on_capacity_errors": true,
    "stop_after_consecutive_errors": 5
  },
  "render": {
    "mode": "videos_only",
    "allow_partial_deliveries": true
  },
  "publishing": {
    "generate_titles": true,
    "generate_descriptions": true,
    "generate_thumbnails": true,
    "thumbnail_provider": "fastgen"
  }
}
